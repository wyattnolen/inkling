{% comment %}
  sections/inkling-footer.liquid
{% endcomment %}

<footer
  id="InklingFooter-{{ section.id }}"
  class="inkling-footer"
  style="
    --footer-bg: {{ section.settings.background_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.muted_text_color }};
    --footer-border: {{ section.settings.border_color }};
  "
>
  <div class="inkling-footer__inner page-width">
    <div class="inkling-footer__brand">
      {% if section.settings.logo != blank %}
        <a href="{{ routes.root_url }}" class="inkling-footer__logo-link" aria-label="{{ shop.name }}">
          {{
            section.settings.logo
            | image_url: width: 360
            | image_tag:
              class: 'inkling-footer__logo',
              loading: 'lazy',
              widths: '160, 240, 320, 360',
              alt: shop.name
          }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="inkling-footer__logo-text">
          {{ shop.name }}
        </a>
      {% endif %}

      {% if section.settings.tagline != blank %}
        <p class="inkling-footer__tagline">
          {{ section.settings.tagline }}
        </p>
      {% endif %}

      <div class="inkling-footer__socials" aria-label="Social links">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="inkling-footer__social" aria-label="Instagram" target="_blank" rel="noopener">
            <span>◎</span>
          </a>
        {% endif %}

        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" class="inkling-footer__social" aria-label="TikTok" target="_blank" rel="noopener">
            <span>♪</span>
          </a>
        {% endif %}

        {% if section.settings.pinterest_url != blank %}
          <a href="{{ section.settings.pinterest_url }}" class="inkling-footer__social" aria-label="Pinterest" target="_blank" rel="noopener">
            <span>p</span>
          </a>
        {% endif %}
      </div>
    </div>

    <nav class="inkling-footer__nav" aria-label="Footer navigation">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_column' %}
            <div class="inkling-footer__column" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2 class="inkling-footer__heading">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.menu != blank %}
                <ul class="inkling-footer__list" role="list">
                  {% for link in block.settings.menu.links %}
                    <li class="inkling-footer__item">
                      <a href="{{ link.url }}" class="inkling-footer__link">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </nav>

    {% if section.settings.doodle_image != blank %}
      <div class="inkling-footer__doodle" aria-hidden="true">
        {{
          section.settings.doodle_image
          | image_url: width: 260
          | image_tag:
            class: 'inkling-footer__doodle-image',
            loading: 'lazy',
            widths: '120, 180, 240, 260',
            alt: ''
        }}
      </div>
    {% else %}
      <div class="inkling-footer__doodle inkling-footer__doodle--fallback" aria-hidden="true">
        <span class="inkling-footer__spark inkling-footer__spark--one">*</span>
        <span class="inkling-footer__spark inkling-footer__spark--two">*</span>
        <span class="inkling-footer__heart">♥</span>
        <span class="inkling-footer__dash inkling-footer__dash--one"></span>
        <span class="inkling-footer__dash inkling-footer__dash--two"></span>
      </div>
    {% endif %}
  </div>

  <div class="inkling-footer__bottom page-width">
    <p class="inkling-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
    </p>

    <div class="inkling-footer__legal">
      {% if section.settings.privacy_url != blank %}
        <a href="{{ section.settings.privacy_url }}" class="inkling-footer__legal-link">
          Privacy Policy
        </a>
      {% endif %}

      {% if section.settings.terms_url != blank %}
        <a href="{{ section.settings.terms_url }}" class="inkling-footer__legal-link">
          Terms of Service
        </a>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .inkling-footer {
    background: var(--footer-bg, #fffdf8);
    color: var(--footer-text, #111);
    border-top: 1px solid var(--footer-border, rgba(17, 17, 17, 0.08));
    font-family: var(--font-body-family, inherit);
  }

  .inkling-footer .page-width {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .inkling-footer__inner {
    display: grid;
    grid-template-columns: minmax(180px, 1.1fr) minmax(420px, 2.2fr) minmax(120px, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .inkling-footer__brand {
    min-width: 0;
  }

  .inkling-footer__logo-link {
    display: inline-flex;
    width: fit-content;
  }

  .inkling-footer__logo {
    display: block;
    width: min(150px, 100%);
    height: auto;
  }

  .inkling-footer__logo-text {
    display: inline-block;
    color: currentColor;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-decoration: none;
    text-transform: uppercase;
  }

  .inkling-footer__tagline {
    max-width: 150px;
    margin: 0.75rem 0 1rem;
    color: var(--footer-text, #111);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .inkling-footer__socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .inkling-footer__social {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .inkling-footer__social:hover {
    transform: translateY(-2px);
    opacity: 0.86;
  }

  .inkling-footer__social:focus-visible,
  .inkling-footer__link:focus-visible,
  .inkling-footer__legal-link:focus-visible {
    outline: 3px solid #ff7fba;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .inkling-footer__nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .inkling-footer__heading {
    margin: 0 0 0.8rem;
    color: var(--footer-text, #111);
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .inkling-footer__list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inkling-footer__link {
    color: var(--footer-text, #111);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .inkling-footer__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .inkling-footer__doodle {
    justify-self: end;
    position: relative;
    min-width: 130px;
    min-height: 110px;
  }

  .inkling-footer__doodle-image {
    display: block;
    width: min(150px, 100%);
    height: auto;
  }

  .inkling-footer__doodle--fallback {
    width: 150px;
    height: 120px;
  }

  .inkling-footer__heart {
    position: absolute;
    right: 24px;
    bottom: 6px;
    display: grid;
    place-items: center;
    width: 78px;
    height: 70px;
    transform: rotate(-8deg);
    border: 4px solid #111;
    border-radius: 44% 44% 50% 50%;
    background: #1466ff;
    color: #111;
    font-size: 0;
  }

  .inkling-footer__heart::before,
  .inkling-footer__heart::after {
    content: '';
    position: absolute;
    top: 26px;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #111;
  }

  .inkling-footer__heart::before {
    left: 25px;
  }

  .inkling-footer__heart::after {
    right: 25px;
  }

  .inkling-footer__spark {
    position: absolute;
    color: #111;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
  }

  .inkling-footer__spark--one {
    top: 0;
    right: 52px;
  }

  .inkling-footer__spark--two {
    top: 20px;
    right: 12px;
    font-size: 1.5rem;
  }

  .inkling-footer__dash {
    position: absolute;
    display: block;
    width: 28px;
    height: 4px;
    border-radius: 999px;
    background: #111;
  }

  .inkling-footer__dash--one {
    left: 0;
    bottom: 46px;
    transform: rotate(25deg);
  }

  .inkling-footer__dash--two {
    left: 5px;
    bottom: 66px;
    transform: rotate(-18deg);
  }

  .inkling-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.85rem;
    padding-bottom: 1.15rem;
    border-top: 1px solid var(--footer-border, rgba(17, 17, 17, 0.08));
  }

  .inkling-footer__copyright {
    margin: 0;
    color: var(--footer-muted, #4d4d4d);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .inkling-footer__legal {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .inkling-footer__legal-link {
    color: var(--footer-text, #111);
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
  }

  .inkling-footer__legal-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  @media screen and (max-width: 900px) {
    .inkling-footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .inkling-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .inkling-footer__doodle {
      justify-self: start;
    }
  }

  @media screen and (max-width: 600px) {
    .inkling-footer__inner {
      padding-top: 2rem;
    }

    .inkling-footer__nav {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 2rem;
    }

    .inkling-footer__tagline {
      max-width: 220px;
    }

    .inkling-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .inkling-footer__legal {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 420px) {
    .inkling-footer__nav {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Inkling footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Art you can wear. Made to be real."
    },
    {
      "type": "image_picker",
      "id": "doodle_image",
      "label": "Right doodle image"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy policy URL"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of service URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#4D4D4D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E8E2D8"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inkling footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Collections"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "About"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}