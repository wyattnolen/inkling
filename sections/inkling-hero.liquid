<section
  id="InklingHero-{{ section.id }}"
  class="inkling-hero"
  style="
    --hero-bg: {{ section.settings.background_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-pink: {{ section.settings.pink_color }};
  "
>
  <div class="inkling-hero__inner">
    <div class="inkling-hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="inkling-hero__heading">
          {{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="inkling-hero__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="inkling-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="inkling-hero__btn inkling-hero__btn--primary" href="{{ section.settings.primary_link }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a class="inkling-hero__btn inkling-hero__btn--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="inkling-hero__media" aria-hidden="true">
      {% if section.settings.hero_image != blank %}
        <picture>
          {% if section.settings.hero_image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.hero_image_mobile | image_url: width: 1200 }}"
            >
          {% endif %}

          {{
            section.settings.hero_image
            | image_url: width: 2200
            | image_tag:
              class: 'inkling-hero__image',
              widths: '900, 1200, 1600, 1800, 2200',
              sizes: '(max-width: 749px) 100vw, 50vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.hero_image.alt
          }}
        </picture>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}

.inkling-hero {
  position: relative;
  overflow: hidden;
  background: var(--hero-bg, #fbf7f1);
}

.inkling-hero__inner {
  display: grid;
  grid-template-columns: 50% 50%;
  align-items: stretch;
  min-height: 560px;
  max-width: 1440px;
  margin: 0 auto;
}

.inkling-hero__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 520px;
  padding: 64px 40px 64px 64px;
  position: relative;
  z-index: 2;
}

.inkling-hero__heading {
  margin: 0;
  color: #050505;
  font-size: clamp(4rem, 5.7vw, 5.8rem);
  line-height: 0.9;
  letter-spacing: -0.06em;
  font-weight: 900;
  text-wrap: balance;
}

.inkling-hero__heading strong,
.inkling-hero__heading em {
  color: var(--hero-accent, #2f67f6);
  font-style: normal;
}

.inkling-hero__text {
  max-width: 360px;
  margin-top: 26px;
  color: #222;
  font-size: 1.1rem;
  line-height: 1.45;
  font-weight: 500;
}

.inkling-hero__text p {
  margin: 0;
}

.inkling-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 30px;
}

.inkling-hero__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 26px;
  border: 2px solid #1a1a1a;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 800;
  text-transform: uppercase;
  text-decoration: none;
  line-height: 1;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.inkling-hero__btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 18px rgb(0 0 0 / 0.08);
}

.inkling-hero__btn--primary {
  background: var(--hero-pink, #f56ab2);
  border-color: var(--hero-pink, #f56ab2);
  color: #111;
}

.inkling-hero__btn--secondary {
  background: transparent;
  color: #111;
}

.inkling-hero__media {
  position: relative;
  min-width: 0;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  justify-content: flex-end;
}

.inkling-hero__media picture {
  display: block;
  width: 100%;
  height: 100%;
}

.inkling-hero__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* Slightly larger desktop layouts */
@media screen and (min-width: 1200px) {
  .inkling-hero__inner {
    min-height: 610px;
  }

  .inkling-hero__content {
    padding-left: 72px;
    padding-right: 48px;
  }

  .inkling-hero__heading {
    font-size: clamp(4.5rem, 5.8vw, 6.2rem);
  }
}

/* Tablet */
@media screen and (max-width: 989px) {
  .inkling-hero__inner {
    grid-template-columns: 1fr 1fr;
    min-height: 500px;
  }

  .inkling-hero__content {
    padding: 48px 24px 48px 32px;
    max-width: 430px;
  }

  .inkling-hero__heading {
    font-size: clamp(3.4rem, 7vw, 4.8rem);
  }

  .inkling-hero__text {
    font-size: 1rem;
    max-width: 320px;
  }

  .inkling-hero__btn {
    min-height: 50px;
    padding: 0 22px;
    font-size: 0.88rem;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  .inkling-hero__inner {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .inkling-hero__content {
    order: 1;
    max-width: none;
    padding: 28px 20px 24px;
  }

  .inkling-hero__heading {
    font-size: clamp(3rem, 13vw, 4.4rem);
    line-height: 0.92;
  }

  .inkling-hero__text {
    max-width: 290px;
    margin-top: 18px;
    font-size: 1rem;
  }

  .inkling-hero__actions {
    gap: 12px;
    margin-top: 22px;
  }

  .inkling-hero__btn {
    flex: 1 1 100%;
    min-height: 50px;
    padding: 0 20px;
    font-size: 0.9rem;
  }

  .inkling-hero__media {
    order: 2;
    height: auto;
    min-height: 0;
  }

  .inkling-hero__media picture {
    height: auto;
  }

  .inkling-hero__image {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center top;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Inkling hero",
  "tag": "section",
  "class": "section-wrapper inkling-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Temporary tats by <strong>real artists.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Express yourself with art that lasts 2–5 days and leaves no trace.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop best sellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Browse artists"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero artwork"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile hero artwork"
    },
    {
      "type": "textarea",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Over\n500+\ndesigns"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffaf3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent blue",
      "default": "#2468f2"
    },
    {
      "type": "color",
      "id": "pink_color",
      "label": "Pink",
      "default": "#ff6ab0"
    },
    {
      "type": "color",
      "id": "yellow_color",
      "label": "Yellow",
      "default": "#ffd82e"
    }
  ],
  "presets": [
    {
      "name": "Inkling hero"
    }
  ]
}
{% endschema %}