<section
  id="InklingHero-{{ section.id }}"
  class="inkling-hero"
  style="
    --hero-bg: {{ section.settings.background_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-pink: {{ section.settings.pink_color }};
    --hero-yellow: {{ section.settings.yellow_color }};
  "
>
  <div class="inkling-hero__inner">
    <div class="inkling-hero__content">
      {% if section.settings.kicker != blank %}
        <p class="inkling-hero__kicker">{{ section.settings.kicker }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="inkling-hero__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="inkling-hero__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="inkling-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="inkling-hero__btn inkling-hero__btn--primary" href="{{ section.settings.primary_link }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a class="inkling-hero__btn inkling-hero__btn--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="inkling-hero__media" aria-hidden="true">
      {% if section.settings.badge_text != blank %}
        <div class="inkling-hero__badge">
          {{ section.settings.badge_text }}
        </div>
      {% endif %}

      {% if section.settings.hero_image != blank %}
        <picture>
          {% if section.settings.hero_image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.hero_image_mobile | image_url: width: 900 }}"
            >
          {% endif %}

          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              class: 'inkling-hero__image',
              widths: '700, 900, 1200, 1500, 1800',
              sizes: '(min-width: 990px) 58vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.hero_image.alt
          }}
        </picture>
      {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'inkling-hero__image inkling-hero__image--placeholder' }}
      {% endif %}
    </div>

    <div class="inkling-hero__decor inkling-hero__decor--heart">♡</div>
    <div class="inkling-hero__decor inkling-hero__decor--star">✶</div>
    <div class="inkling-hero__decor inkling-hero__decor--sparkle">✧</div>

    <span class="inkling-hero__dot inkling-hero__dot--one"></span>
    <span class="inkling-hero__dot inkling-hero__dot--two"></span>
    <span class="inkling-hero__dot inkling-hero__dot--three"></span>
    <span class="inkling-hero__dot inkling-hero__dot--four"></span>
    <span class="inkling-hero__dot inkling-hero__dot--five"></span>
  </div>

  <div class="inkling-hero__wave" aria-hidden="true"></div>
</section>

{% stylesheet %}
  .inkling-hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-bg, #fffaf3);
    min-height: clamp(460px, 44vw, 620px);
    isolation: isolate;
  }

  .inkling-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(480px, 1.2fr);
    align-items: center;
    gap: clamp(24px, 4vw, 72px);
    max-width: 1440px;
    min-height: inherit;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 84px) clamp(20px, 5vw, 96px);
  }

  .inkling-hero__content {
    position: relative;
    z-index: 4;
    max-width: 540px;
  }

  .inkling-hero__kicker {
    margin: 0 0 12px;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .inkling-hero__heading {
    margin: 0;
    color: #050505;
    font-size: clamp(3.4rem, 6vw, 6.8rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
    font-weight: 950;
    text-wrap: balance;
  }

  .inkling-hero__heading strong,
  .inkling-hero__heading em {
    color: var(--hero-accent, #2468f2);
    font-style: normal;
  }

  .inkling-hero__text {
    max-width: 410px;
    margin-top: 24px;
    color: #2b2b2b;
    font-size: clamp(1rem, 1.25vw, 1.25rem);
    line-height: 1.45;
    font-weight: 600;
  }

  .inkling-hero__text p {
    margin: 0;
  }

  .inkling-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
  }

  .inkling-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 28px;
    border: 2px solid #1f2933;
    border-radius: 12px;
    color: #111;
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .inkling-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 0 rgb(0 0 0 / 0.14);
  }

  .inkling-hero__btn--primary {
    border-color: var(--hero-pink, #ff6ab0);
    background: var(--hero-pink, #ff6ab0);
  }

  .inkling-hero__btn--secondary {
    background: #fff;
  }

  .inkling-hero__media {
    position: relative;
    z-index: 3;
    align-self: stretch;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-width: 0;
  }

  .inkling-hero__image {
    display: block;
    width: min(100%, 860px);
    height: auto;
    object-fit: contain;
    object-position: center bottom;
    transform: translateY(36px);
  }

  .inkling-hero__badge {
    position: absolute;
    top: clamp(10px, 5vw, 44px);
    right: clamp(0px, 3vw, 36px);
    z-index: 4;
    display: grid;
    place-items: center;
    width: clamp(104px, 9vw, 140px);
    aspect-ratio: 1;
    padding: 18px;
    background: var(--hero-yellow, #ffd82e);
    color: #111;
    font-weight: 950;
    font-size: clamp(0.9rem, 1.2vw, 1.15rem);
    line-height: 1.05;
    text-align: center;
    text-transform: uppercase;
    clip-path: polygon(
      50% 0%,
      58% 10%,
      70% 5%,
      76% 17%,
      89% 16%,
      90% 30%,
      100% 38%,
      92% 50%,
      100% 62%,
      90% 70%,
      89% 84%,
      76% 83%,
      70% 95%,
      58% 90%,
      50% 100%,
      42% 90%,
      30% 95%,
      24% 83%,
      11% 84%,
      10% 70%,
      0% 62%,
      8% 50%,
      0% 38%,
      10% 30%,
      11% 16%,
      24% 17%,
      30% 5%,
      42% 10%
    );
  }

  .inkling-hero__wave {
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: -90px;
    z-index: 1;
    height: clamp(130px, 14vw, 220px);
    background: var(--hero-yellow, #ffd82e);
    border-radius: 50% 50% 0 0 / 45% 45% 0 0;
    transform: rotate(-1.5deg);
  }

  .inkling-hero__decor,
  .inkling-hero__dot {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    user-select: none;
  }

  .inkling-hero__decor {
    color: #050505;
    font-weight: 700;
    line-height: 1;
  }

  .inkling-hero__decor--heart {
    left: 41%;
    top: 58%;
    font-size: clamp(2.2rem, 4vw, 4.8rem);
    transform: rotate(-12deg);
  }

  .inkling-hero__decor--star {
    left: 47%;
    top: 13%;
    font-size: clamp(2.1rem, 3.6vw, 4.2rem);
  }

  .inkling-hero__decor--sparkle {
    right: 5%;
    bottom: 22%;
    font-size: clamp(2.4rem, 4vw, 4.6rem);
  }

  .inkling-hero__dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--hero-accent, #2468f2);
  }

  .inkling-hero__dot--one {
    left: 4%;
    top: 38%;
    background: #ff6ab0;
  }

  .inkling-hero__dot--two {
    left: 31%;
    top: 45%;
    width: 18px;
    height: 18px;
  }

  .inkling-hero__dot--three {
    left: 54%;
    top: 24%;
    background: #ffd82e;
  }

  .inkling-hero__dot--four {
    right: 19%;
    top: 24%;
    background: #62c9a7;
  }

  .inkling-hero__dot--five {
    right: 8%;
    top: 8%;
    background: #ff6ab0;
  }

  @media screen and (max-width: 989px) {
    .inkling-hero {
      min-height: auto;
    }

    .inkling-hero__inner {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-top: 40px;
      padding-bottom: 0;
      text-align: left;
    }

    .inkling-hero__content {
      max-width: 620px;
    }

    .inkling-hero__media {
      min-height: 340px;
    }

    .inkling-hero__image {
      width: min(100%, 760px);
      transform: translateY(28px);
    }

    .inkling-hero__badge {
      top: 16px;
      right: 4px;
    }

    .inkling-hero__decor--heart {
      left: 7%;
      top: 52%;
    }

    .inkling-hero__decor--star {
      left: auto;
      right: 26%;
      top: 45%;
    }

    .inkling-hero__decor--sparkle {
      right: 7%;
      bottom: 16%;
    }
  }

  @media screen and (max-width: 749px) {
    .inkling-hero__inner {
      padding-inline: 20px;
    }

    .inkling-hero__heading {
      font-size: clamp(3.1rem, 15vw, 5rem);
    }

    .inkling-hero__actions {
      gap: 12px;
    }

    .inkling-hero__btn {
      flex: 1 1 100%;
      min-height: 50px;
    }

    .inkling-hero__media {
      min-height: 300px;
      margin-inline: -20px;
    }

    .inkling-hero__image {
      width: 115%;
      max-width: none;
    }

    .inkling-hero__badge {
      width: 96px;
      font-size: 0.78rem;
      right: 18px;
    }

    .inkling-hero__dot--two,
    .inkling-hero__dot--four,
    .inkling-hero__dot--five {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Inkling hero",
  "tag": "section",
  "class": "section-wrapper inkling-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Temporary tats by <strong>real artists.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Express yourself with art that lasts 2–5 days and leaves no trace.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop best sellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Browse artists"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero artwork"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile hero artwork"
    },
    {
      "type": "textarea",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Over\n500+\ndesigns"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffaf3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent blue",
      "default": "#2468f2"
    },
    {
      "type": "color",
      "id": "pink_color",
      "label": "Pink",
      "default": "#ff6ab0"
    },
    {
      "type": "color",
      "id": "yellow_color",
      "label": "Yellow",
      "default": "#ffd82e"
    }
  ],
  "presets": [
    {
      "name": "Inkling hero"
    }
  ]
}
{% endschema %}