<section
  id="InklingHero-{{ section.id }}"
  class="inkling-hero"
  style="
    --hero-bg: {{ section.settings.background_color }};
    --hero-accent: {{ section.settings.accent_color }};
    --hero-pink: {{ section.settings.pink_color }};

    {% if section.settings.hero_image != blank %}
      --hero-image-desktop: url('{{ section.settings.hero_image | image_url: width: 2400 }}');
    {% endif %}

    {% if section.settings.hero_image_mobile != blank %}
      --hero-image-mobile: url('{{ section.settings.hero_image_mobile | image_url: width: 1200 }}');
    {% endif %}
  "
>
  <div class="inkling-hero__art" aria-hidden="true"></div>

  <div class="inkling-hero__inner">
    <div class="inkling-hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="inkling-hero__heading">
          {{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="inkling-hero__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="inkling-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="inkling-hero__btn inkling-hero__btn--primary" href="{{ section.settings.primary_link }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a class="inkling-hero__btn inkling-hero__btn--secondary" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}

.inkling-hero {
  position: relative;
  overflow: hidden;
  background: var(--hero-bg, #fdf6e9);
  min-height: 560px;
  isolation: isolate;
}

.inkling-hero__art {
  position: absolute;
  inset: 0;
  z-index: 1;
  background-image: var(--hero-image-desktop);
  background-repeat: no-repeat;
  background-size: auto 100%;
  background-position: right center;
  pointer-events: none;
}

.inkling-hero__inner {
  position: relative;
  z-index: 2;
  min-height: inherit;
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  padding: 64px clamp(40px, 6vw, 88px);
}

.inkling-hero__content {
  width: min(100%, 560px);
}

.inkling-hero__heading {
  margin: 0;
  color: #050505;
  font-size: clamp(3.8rem, 4.6vw, 5.45rem);
  line-height: 0.9;
  letter-spacing: -0.065em;
  font-weight: 900;
  text-wrap: balance;
}

.inkling-hero__heading strong,
.inkling-hero__heading em {
  color: var(--hero-accent, #2468f2);
  font-style: normal;
}

.inkling-hero__text {
  max-width: 380px;
  margin-top: 26px;
  color: #222;
  font-size: 1.12rem;
  line-height: 1.45;
  font-weight: 500;
}

.inkling-hero__text p {
  margin: 0;
}

.inkling-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 30px;
}

.inkling-hero__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 28px;
  border: 2px solid #1a1a1a;
  border-radius: 12px;
  color: #111;
  font-size: 0.95rem;
  font-weight: 800;
  text-transform: uppercase;
  text-decoration: none;
  line-height: 1;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.inkling-hero__btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 18px rgb(0 0 0 / 0.08);
}

.inkling-hero__btn--primary {
  background: var(--hero-pink, #ff6ab0);
  border-color: var(--hero-pink, #ff6ab0);
}

.inkling-hero__btn--secondary {
  background: transparent;
}

/* Large desktop */
@media screen and (min-width: 1200px) {
  .inkling-hero {
    min-height: 590px;
  }

  .inkling-hero__inner {
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .inkling-hero__content {
    width: min(100%, 570px);
  }

  .inkling-hero__heading {
    font-size: clamp(4rem, 4.8vw, 5.7rem);
  }
}

/* Very wide screens */
@media screen and (min-width: 1500px) {
  .inkling-hero {
    min-height: 620px;
  }

  .inkling-hero__art {
    background-size: auto 100%;
    background-position: right center;
  }

  .inkling-hero__inner {
    max-width: 1520px;
  }
}

/* Medium desktop / small laptop */
@media screen and (max-width: 1199px) and (min-width: 990px) {
  .inkling-hero {
    min-height: 540px;
  }

  .inkling-hero__inner {
    padding: 56px 40px;
  }

  .inkling-hero__content {
    width: min(100%, 470px);
  }

  .inkling-hero__heading {
    font-size: clamp(3.25rem, 5vw, 4.35rem);
  }

  .inkling-hero__text {
    max-width: 330px;
    font-size: 1rem;
  }

  .inkling-hero__art {
    background-size: auto 100%;
    background-position: right center;
  }
}

/* Tablet and mobile: stack content first, artwork second */
@media screen and (max-width: 989px) {
  .inkling-hero {
    display: flex;
    flex-direction: column;
    min-height: auto;
  }

  .inkling-hero__inner {
    order: 1;
    display: block;
    width: 100%;
    min-height: auto;
    padding: 40px 24px 24px;
  }

  .inkling-hero__content {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
  }

  .inkling-hero__heading {
    font-size: clamp(3.7rem, 10vw, 6rem);
    line-height: 0.9;
  }

  .inkling-hero__text {
    max-width: 420px;
    margin-top: 20px;
    font-size: 1.05rem;
  }

  .inkling-hero__actions {
    gap: 14px;
    margin-top: 24px;
  }

  .inkling-hero__art {
    order: 2;
    position: relative;
    inset: auto;
    z-index: 1;
    display: block;
    width: 100%;
    height: min(82vw, 640px);
    margin-top: 4px;
    background-image: var(--hero-image-mobile, var(--hero-image-desktop));
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center top;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  .inkling-hero__inner {
    padding: 32px 20px 18px;
  }

  .inkling-hero__content {
    max-width: none;
  }

  .inkling-hero__heading {
    font-size: clamp(3.15rem, 14vw, 4.8rem);
    line-height: 0.9;
  }

  .inkling-hero__text {
    max-width: 320px;
    margin-top: 18px;
    font-size: 1rem;
  }

  .inkling-hero__actions {
    gap: 12px;
    margin-top: 22px;
  }

  .inkling-hero__btn {
    flex: 1 1 100%;
    min-height: 50px;
    padding: 0 20px;
    font-size: 0.9rem;
  }

  .inkling-hero__art {
    height: min(112vw, 620px);
    margin-top: 0;
  }
}

/* Small mobile */
@media screen and (max-width: 420px) {
  .inkling-hero__inner {
    padding: 28px 18px 16px;
  }

  .inkling-hero__heading {
    font-size: clamp(2.95rem, 14.8vw, 4.1rem);
  }

  .inkling-hero__art {
    height: min(122vw, 560px);
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Inkling hero",
  "tag": "section",
  "class": "section-wrapper inkling-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Temporary tats by <strong>real artists.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Express yourself with art that lasts 2–5 days and leaves no trace.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop best sellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Browse artists"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero artwork"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile hero artwork"
    },
    {
      "type": "textarea",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Over\n500+\ndesigns"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffaf3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent blue",
      "default": "#2468f2"
    },
    {
      "type": "color",
      "id": "pink_color",
      "label": "Pink",
      "default": "#ff6ab0"
    },
    {
      "type": "color",
      "id": "yellow_color",
      "label": "Yellow",
      "default": "#ffd82e"
    }
  ],
  "presets": [
    {
      "name": "Inkling hero"
    }
  ]
}
{% endschema %}